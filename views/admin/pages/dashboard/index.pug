extends ../../layouts/default.pug

block main
    // Main Content
    main.flex-grow.p-6
        header.flex.justify-between.items-center.mb-6
            h2.text-2xl.font-semibold Overview
            .flex.items-center.space-x-4
                input.px-4.py-2.border.rounded-lg(type='text' placeholder='Search')
                img.w-10.h-10.rounded-full(src='https://via.placeholder.com/40' alt='User')
        section.mb-6
            h3.text-lg.font-semibold.mb-2 Top Sales Representative
            .bg-white.shadow-md.rounded-lg.p-4
                table.w-full.text-left
                    thead
                        tr.border-b
                        th.py-2 Name
                        th.py-2 Thumbnail
                        th.py-2 Products
                        th.py-2 Status
                        th.py-2 Rank
                    tbody
                        each p in metadata.productSolds
                           
                            tr.border-b(class='hover:bg-gray-50')
                                td.py-2.px-4=p.product.title
                                td.py-2.px-4
                                    img.w-10.h-10.object-cover.rounded-md(src=`${p.product.thumbnail}` alt='Product Thumbnail')
                                td.py-2.px-4=p.total_quantity
                                td.py-2.px-4
                                    span.px-2.py-1.text-xs.font-semibold.rounded(
                                        class=`${ p.product.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`
                                    )=p.product.status
                                td.py-2.px-4.font-semibold.text-yellow-500=p.rank
        
        section.grid.grid-cols-4.gap-6.mb-6
            .bg-white.shadow-md.rounded-lg.p-4
                p.text-gray-500 Product Sold
                h3.text-2xl.font-bold=metadata.totalOrder.count
                p(class=`${metadata.totalOrder.progress >= 0 ? 'text-green-500' : 'text-red-500'}`)=`${metadata.totalOrder.progress}%`
            .bg-white.shadow-md.rounded-lg.p-4
                p.text-gray-500 Total Profit
                h3.text-2xl.font-bold=metadata.totalClaim.count
                p(class=`${metadata.totalClaim.progress >= 0 ? 'text-green-500' : 'text-red-500'}`)=`${metadata.totalClaim.progress}%`
       
        section.bg-white.shadow-md.rounded-lg.p-4
            h3.text-lg.font-semibold.mb-2 Claims Over the Years
            canvas#claimsChart.h-48.w-full(monthlyClaim=metadata.monthlyClaim)

    script(src="https://cdn.jsdelivr.net/npm/chart.js") 
    script(src="/admin/js/chart.js") 
